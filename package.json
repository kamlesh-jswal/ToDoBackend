{
    "name": "todo-backend",
    "version": "1.0.0",
    "description": "RESTful ToDo backend with Express, TypeScript, MongoDB",
    "main": "dist/server.js",
    "type": "commonjs",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "lint": "eslint ."
    },
    "keywords": [
        "todo",
        "express",
        "typescript",
        "mongodb"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
