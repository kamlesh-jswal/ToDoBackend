        "cors": "^2.8.5",
        "dotenv": "^16.0.0",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^7.6.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.13",
        "@types/express": "^4.17.17",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.14.7",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-import": "^2.27.5",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.5.0",
        "jiti": "^2.6.1",
        "prettier": "^3.0.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.5.0",
        "typescript-eslint": "^8.58.2"
